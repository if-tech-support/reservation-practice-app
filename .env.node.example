# Node.js（PostgreSQL）で動かすときの環境変数。AWS では Secrets Manager とタスク定義から渡す
APP_ENV=local
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
# RDS へつなぐときは require にする
DATABASE_SSL=disable
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-only-secret-change-me-0123456789
ADMIN_EMAIL=admin@example.com
