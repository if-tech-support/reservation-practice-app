{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "./worker-configuration.d.ts"],
    "paths": { "#platform": ["./src/server/platform.cloudflare.ts"] }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/server/platform.node.ts", "src/server/db/schema.pg.ts"]
}
